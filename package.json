{
  "name": "dsh-system-vitals",
  "version": "1.3.5",
  "description": "Live CPU, CPU temperature, memory, disk and upload/download throughput inside the DeepSeek Harness composer tool row. Linux, macOS and Windows.",
  "type": "module",
  "license": "MIT",
  "author": "abyss2021",
  "homepage": "https://github.com/abyss2021/dsh-system-vitals#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abyss2021/dsh-system-vitals.git"
  },
  "bugs": {
    "url": "https://github.com/abyss2021/dsh-system-vitals/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-monitor",
    "cpu",
    "memory",
    "temperature",
    "network",
    "linux",
    "macos",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "platform/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
